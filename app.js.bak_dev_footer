    }

    tbody.innerHTML = p.ledger.map((e, idx) => {
        const inStr = e.inQty > 0 ? `<span class="font-extrabold text-emerald-600">+${e.inQty.toLocaleString()} ${p.unit}</span>` : `<span class="text-slate-300">-</span>`;
