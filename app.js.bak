function renderWarehouseTable(filterCat = 'all') {
    const tbody = document.getElementById('warehouse-items-tbody');
    if (!tbody) return;

    const filtered = filterCat === 'all' 
        ? WAREHOUSE_ITEMS 
        : WAREHOUSE_ITEMS.filter(it => it.cat === filterCat);

    tbody.innerHTML = filtered.map(item => {
        let badgeClass = "badge-active";
        if (item.status === 'Kamaymoqda') {
            badgeClass = "px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold";
        }

        let catBadge = "bg-slate-100 text-slate-700";
        if (item.cat === 'don') catBadge = "bg-amber-100 text-amber-800";
        if (item.cat === 'sabzavot') catBadge = "bg-orange-100 text-orange-800";
        if (item.cat === 'sut') catBadge = "bg-blue-100 text-blue-800";
        if (item.cat === 'konserva') catBadge = "bg-yellow-100 text-yellow-800";

        return `
            <tr class="hover:bg-slate-50/80 transition">
                <td class="p-3"><span class="px-2 py-0.5 rounded-lg text-[10px] font-bold ${catBadge}">${item.catName}</span></td>
                <td class="p-3 font-bold text-slate-900">${item.name}</td>
                <td class="p-3 text-slate-500">${item.supplier}</td>
                <td class="p-3 font-mono text-[10px] bg-slate-100 px-2 py-0.5 rounded inline-block mt-2.5">${item.invoice}</td>
                <td class="p-3 text-emerald-600 font-extrabold">${item.inQty} ${item.unit}</td>
                <td class="p-3 text-red-600 font-extrabold">${item.outQty} ${item.unit}</td>
                <td class="p-3 font-black text-slate-900">${item.stock} ${item.unit}</td>
                <td class="p-3"><span class="${badgeClass}">${item.status}</span></td>
            </tr>
        `;
    }).join('');
}

function filterWarehouseCategory(category) {
    document.querySelectorAll('.wh-cat-btn').forEach(b => {
        b.className = "wh-cat-btn px-3.5 py-2 rounded-xl text-xs font-bold text-slate-700 hover:bg-slate-100 flex items-center gap-1.5 transition";
    });
    const activeBtn = document.getElementById(`wh-cat-${category}`);
    if (activeBtn) {
        activeBtn.className = "wh-cat-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-blue-600 text-white flex items-center gap-1.5 transition shadow-sm";
    }
    renderWarehouseTable(category);
}

function openAddWarehouseItemModal() {
    const modal = document.getElementById('modal-add-warehouse-item');
    if (modal) modal.classList.remove('hidden');
}

function addNewWarehouseItemAction(e) {
    e.preventDefault();
    const name = document.getElementById('new-wh-name')?.value;
    const cat = document.getElementById('new-wh-category')?.value;
    const supplier = document.getElementById('new-wh-supplier')?.value;
    const invoice = document.getElementById('new-wh-invoice')?.value;
    const qty = parseFloat(document.getElementById('new-wh-qty')?.value) || 0;

    let catShort = "don";
    if (cat.includes("Sabzavot")) catShort = "sabzavot";
    if (cat.includes("Sut")) catShort = "sut";
    if (cat.includes("Konserva")) catShort = "konserva";

    WAREHOUSE_ITEMS.unshift({
        cat: catShort,
        catName: cat,
        name: name,
        supplier: supplier,
        invoice: invoice,
        inQty: qty,
        outQty: 0,
        stock: qty,
        unit: "kg",
        status: "Yetarli"
    });

    closeModal('modal-add-warehouse-item');
    filterWarehouseCategory(catShort);
    showToast(`📦 Yangi mahsulot omborga qabul qilindi: "${name}" (${qty} kg)`);
}

